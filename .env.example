# Docker Compose configuration. Credentials live in .secrets/, not in this file.
PUID=1000
PGID=1000
BIND_ADDRESS=127.0.0.1
PORT=3000
YNAB_ENABLE_WRITES=false
YNAB_DEFAULT_PLAN_ID=
# Empty allows every plan owned by this YNAB account. Otherwise comma-separated UUIDs.
YNAB_ALLOWED_PLAN_IDS=
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],ynab-mcp
MCP_ALLOWED_ORIGINS=
# Required only for the chatgpt Compose profile.
OPENAI_TUNNEL_ID=
TUNNEL_CLIENT_IMAGE=ghcr.io/openai/tunnel-client:v0.0.15
