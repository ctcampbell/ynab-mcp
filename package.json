{
  "name": "ynab-local-mcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A self-hosted YNAB MCP server with optional edits and desktop client support",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm plugin:check",
    "setup": "node scripts/setup.mjs",
    "smoke": "tsx scripts/smoke.ts",
    "plugin:build": "node scripts/build-plugin.mjs",
    "server:package": "node scripts/package-server.mjs",
    "plugin:check": "node scripts/check-plugin.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "express": "^5.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "ajv": "^8.20.0",
    "fflate": "^0.8.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  },
  "license": "MIT"
}
